<!-- hyva_ handle: only applied on Hyvä themes -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="checkout.cart.form.before">
            <block name="sps.quotation.quote.required.cart" template="SPS_QuotationHyva::quote-required/notice.phtml">
                <arguments>
                    <argument name="context" xsi:type="string">cart</argument>
                </arguments>
            </block>
            <block name="sps.quotation.cart.notice" template="SPS_QuotationHyva::quotation/notice.phtml">
                <arguments>
                    <argument name="context" xsi:type="string">cart</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
