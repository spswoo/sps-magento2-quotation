 *
 * "Shipping quote required" notice. Block argument "context":
 *  - product  : product page (product.info.additional)
 *  - cart     : cart page (checkout.cart.form.before)
 *  - checkout : Hyvä Checkout shipping step (it hides unavailable rates, so the notice carrier's explanation
 *               would otherwise not be shown) — used by SPS_QuotationHyvaCheckout
 */
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use SPS\Quotation\ViewModel\CartRequest;
use SPS\Quotation\ViewModel\QuoteRequiredNotice;
use SPS\Quotation\ViewModel\RequestForm;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$notice = $viewModels->require(QuoteRequiredNotice::class);
$context = (string) $block->getData('context');
$linkClass = 'font-semibold underline';
if ($context === 'cart' || $context === 'checkout') {
    $html = $context === 'cart' ? $notice->getCartMessageHtml($linkClass) : $notice->getCheckoutMessageHtml($linkClass);
    // "Request a quote for my cart"; the dialog is SPS_QuotationHyva::request/form.phtml in mode "cart"
    $canRequestCart = $html !== '' && $viewModels->require(CartRequest::class)->isAvailable();
} else {
    /** @var \Magento\Catalog\Block\Product\View $block */
    $html = $notice->getProductMessageHtml($block->getProduct(), $linkClass);
    // "Request a shipping quote" button; the dialog itself is SPS_QuotationHyva::request/form.phtml
    $canRequest = $html !== '' && $viewModels->require(RequestForm::class)->isAvailable($block->getProduct());
}
if ($html === '') {
    return;
}
$icons = $viewModels->require(LucideIcons::class);
?>
<div class="<?= $context === 'product' ? 'my-4' : 'mb-6' ?> flex gap-3 rounded-md border border-amber-300 bg-amber-50 p-4 text-sm leading-relaxed text-amber-950" role="note">
    <span class="shrink-0 text-amber-700"><?= $icons->truckHtml('', 22, 22, ['aria-hidden' => 'true']) ?></span>
    <div>
        <p>
            <strong class="block text-base"><?= $escaper->escapeHtml(__('Shipping quote required')) ?></strong>
            <?= /* @noEscape — escaped in QuoteRequiredNotice, phone/e-mail links added */ $html ?>
        </p>
        <?php if (!empty($canRequest)): ?>
            <div class="mt-3" x-data="spsQuotationOpener">
                <button type="button" class="btn btn-primary" @click="open"><?= $escaper->escapeHtml(__('Request a shipping quote')) ?></button>
            </div>
            <?php /* filled from the visitor's cart (section data): the product page is page-cached */ ?>
            <p class="mt-2" x-data="spsQuotationCartHint" x-show="hasOthers" x-cloak
               data-product-id="<?= (int) $block->getProduct()->getId() ?>"
               @private-content-loaded.window="receive">
                <span x-text="text"></span>
                <a class="<?= $escaper->escapeHtmlAttr($linkClass) ?>" href="<?= $escaper->escapeUrl($block->getUrl('checkout/cart')) ?>"><?= $escaper->escapeHtml(__('Request a quote for your whole cart instead')) ?></a>
            </p>
        <?php endif; ?>
        <?php if (!empty($canRequestCart)): ?>
            <div class="mt-3" x-data="spsQuotationOpener">
                <button type="button" class="btn btn-primary" @click="open"><?= $escaper->escapeHtml(__('Request a quote for my cart')) ?></button>
            </div>
        <?php endif; ?>
    </div>
</div>
