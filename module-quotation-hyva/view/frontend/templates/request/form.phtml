declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Catalog\Block\Product\View;
use Magento\Framework\Escaper;
use SPS\Quotation\ViewModel\RequestForm;

/** @var View $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

$form = $viewModels->require(RequestForm::class);
$product = $block->getProduct();
if (!$form->isAvailable($product)) {
    return;
}
$defaultCountry = $form->getDefaultCountry();
?>
<div x-data="spsQuotationRequest" @sps-quotation-request-open.window="open">
    <dialog x-ref="dialog" class="w-full max-w-xl rounded-lg p-0 shadow-xl backdrop:bg-black/50"
            aria-labelledby="sps-quotation-request-title">
        <form x-ref="form" @submit.prevent="submit" class="p-6" novalidate
              action="<?= $escaper->escapeUrl($form->getSubmitUrl()) ?>">
            <div class="mb-4 flex items-start justify-between gap-4">
                <h2 id="sps-quotation-request-title" class="text-xl font-semibold">
                    <?= $escaper->escapeHtml(__('Request a shipping quote')) ?>
                </h2>
                <button type="button" class="p-1 text-gray-500 hover:text-gray-900" @click="close"
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Close')) ?>">&times;</button>
            </div>

            <div x-show="isDone" class="space-y-4" role="status">
                <p class="rounded-md bg-green-50 p-4 text-green-900" x-text="message"></p>
                <div class="text-right">
                    <button type="button" class="btn btn-primary" @click="close"><?= $escaper->escapeHtml(__('Close')) ?></button>
                </div>
            </div>

            <div x-show="isOpenForm" class="space-y-4">
                <p class="text-sm text-gray-700">
                    <strong><?= $escaper->escapeHtml($product->getName()) ?></strong><br>
                    <?= $escaper->escapeHtml($form->getIntro()) ?>
                </p>
                <input type="hidden" name="product_id" value="<?= (int) $product->getId() ?>">
                <div class="hidden" aria-hidden="true">
                    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <label class="block text-sm"><?= $escaper->escapeHtml(__('First name')) ?> *
                        <input class="form-input w-full" name="firstname" autocomplete="given-name" required></label>
                    <label class="block text-sm"><?= $escaper->escapeHtml(__('Last name')) ?> *
                        <input class="form-input w-full" name="lastname" autocomplete="family-name" required></label>
                    <label class="block text-sm"><?= $escaper->escapeHtml(__('E-mail')) ?> *
                        <input class="form-input w-full" type="email" name="email" autocomplete="email" required></label>
                    <label class="block text-sm"><?= $escaper->escapeHtml(__('Phone')) ?> *
                        <input class="form-input w-full" type="tel" name="phone" autocomplete="tel" required></label>
                    <label class="block text-sm sm:col-span-2"><?= $escaper->escapeHtml(__('Company (optional)')) ?>
                        <input class="form-input w-full" name="company" autocomplete="organization"></label>
                    <label class="block text-sm"><?= $escaper->escapeHtml(__('Ship to country')) ?> *
                        <select class="form-select w-full" name="country_id" autocomplete="country" required>
                            <?php foreach ($form->getCountries() as $country): ?>
                                <option value="<?= $escaper->escapeHtmlAttr($country['value']) ?>"
                                    <?= $country['value'] === $defaultCountry ? 'selected' : '' ?>><?= $escaper->escapeHtml($country['label']) ?></option>
                            <?php endforeach; ?>
                        </select></label>
                    <label class="block text-sm"><?= $escaper->escapeHtml(__('Postal / ZIP code')) ?> *
                        <input class="form-input w-full" name="postcode" autocomplete="postal-code" required></label>
                    <label class="block text-sm"><?= $escaper->escapeHtml(__('City')) ?>
                        <input class="form-input w-full" name="city" autocomplete="address-level2"></label>
                    <label class="block text-sm"><?= $escaper->escapeHtml(__('Quantity')) ?> *
                        <input class="form-input w-full" type="number" name="qty" min="1" max="9999" step="1" value="1" x-ref="qty" required></label>
                    <label class="block text-sm sm:col-span-2"><?= $escaper->escapeHtml(__('Message (optional)')) ?>
                        <textarea class="form-input w-full" name="message" rows="3" maxlength="2000"
                                  placeholder="<?= $escaper->escapeHtmlAttr(__('Delivery details, e.g. residential address, stairs, deadline')) ?>"></textarea></label>
                </div>
                <p x-show="hasError" class="rounded-md bg-red-50 p-3 text-sm text-red-800" role="alert" x-text="message"></p>
                <div class="flex justify-end gap-3">
                    <button type="button" class="btn btn-secondary" @click="close"><?= $escaper->escapeHtml(__('Cancel')) ?></button>
                    <button type="submit" class="btn btn-primary" :disabled="isSubmitting"><?= $escaper->escapeHtml(__('Send request')) ?></button>
                </div>
            </div>
        </form>
    </dialog>
</div>
<script>
    (() => {
        const failed = <?= /* @noEscape */ json_encode((string) __('Sorry, your request could not be sent. Please contact us directly.'), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
        const incomplete = <?= /* @noEscape */ json_encode((string) __('Please fill in all required fields.'), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;

        function spsQuotationRequest() {
            return {
                state: 'form',
                message: '',
                get isDone() { return this.state === 'done'; },
                get isOpenForm() { return this.state !== 'done'; },
                get isSubmitting() { return this.state === 'sending'; },
                get hasError() { return this.state === 'error'; },
                open() {
                    const productQty = document.querySelector('#product_addtocart_form input[name="qty"]');
                    if (productQty && parseInt(productQty.value, 10) > 0) {
                        this.$refs.qty.value = productQty.value;
                    }
                    if (this.state !== 'done') {
                        this.state = 'form';
                    }
                    this.$refs.dialog.showModal();
                    const first = this.$refs.form.querySelector('input[name="firstname"]');
                    if (first) { first.focus(); }
                },
                close() {
                    this.$refs.dialog.close();
                },
                async submit() {
                    const form = this.$refs.form;
                    if (!form.checkValidity()) {
                        form.reportValidity();
                        this.message = incomplete;
                        this.state = 'error';
                        return;
                    }
                    const data = new FormData(form);
                    data.append('form_key', hyva.getFormKey());
                    // custom options chosen in the product form (options[id] / options[id][])
                    const productForm = document.getElementById('product_addtocart_form');
                    if (productForm) {
                        for (const [key, value] of new FormData(productForm).entries()) {
                            if (/^options\[\d+\](\[\])?$/.test(key) && typeof value === 'string' && value !== '') {
                                data.append(key, value);
                            }
                        }
                    }
                    this.state = 'sending';
                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: data,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                            credentials: 'same-origin'
                        });
                        const result = await response.json().catch(() => ({}));
                        this.message = result.message || failed;
                        this.state = result.success ? 'done' : 'error';
                        if (result.success) {
                            form.reset();
                        }
                    } catch (e) {
                        this.message = failed;
                        this.state = 'error';
                    }
                }
            };
        }

        function spsQuotationOpener() {
            return {
                open() {
                    window.dispatchEvent(new CustomEvent('sps-quotation-request-open'));
                }
            };
        }

        const register = () => {
            Alpine.data('spsQuotationRequest', spsQuotationRequest);
            Alpine.data('spsQuotationOpener', spsQuotationOpener);
        };
        if (window.Alpine) {
            register();
        } else {
            window.addEventListener('alpine:init', register, { once: true });
        }
    })();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
