<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Hyvä Checkout drops shipping rates that return an error (incl. the spsquote explanation) → show it above the methods -->
        <referenceContainer name="checkout.shipping.methods.before">
            <block name="sps.quotation.quote.required.checkout" template="SPS_QuotationHyva::quote-required/notice.phtml">
                <arguments>
                    <argument name="context" xsi:type="string">checkout</argument>
                </arguments>
            </block>
            <!-- carts built from a quotation: what is quoted + warning when the address is outside the quoted destination -->
            <block name="sps.quotation.checkout.notice" template="SPS_QuotationHyvaCheckout::quotation-notice.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">SPS\QuotationHyvaCheckout\Magewire\QuotationNotice</argument>
                </arguments>
                <block name="sps.quotation.checkout.notice.content" template="SPS_QuotationHyva::quotation/notice.phtml">
                    <arguments>
                        <argument name="context" xsi:type="string">checkout</argument>
                    </arguments>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
