<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Hyvä Checkout drops shipping rates that return an error (incl. the spsquote explanation) → show it above the methods -->
        <referenceContainer name="checkout.shipping.methods.before">
            <block name="sps.quotation.quote.required.checkout" template="SPS_QuotationHyva::quote-required/notice.phtml">
                <arguments>
                    <argument name="context" xsi:type="string">checkout</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
