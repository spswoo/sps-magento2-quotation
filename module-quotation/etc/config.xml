<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <carriers>
            <!-- "Quote required" notice carrier: never offers a rate, only explains why shipping must be quoted -->
            <spsquote>
                <model>SPS\Quotation\Model\Carrier\QuoteRequired</model>
                <active>1</active>
                <title>Shipping quote required</title>
                <sallowspecific>0</sallowspecific>
                <showmethod>1</showmethod>
                <sort_order>999</sort_order>
                <!-- carrier codes still offered when the cart needs a quote, e.g. store pickup -->
                <allowed_carriers/>
                <checkout_message>Shipping for {products} needs a quote from our team. Please contact us at {phone} or {email}.</checkout_message>
                <product_message>Shipping for this item is quoted by our team. Contact us at {phone} or {email} for a shipping quote.</product_message>
                <cart_message>Your cart contains items that need a shipping quote: {products}. Contact us at {phone} or {email}.</cart_message>
            </spsquote>
        </carriers>
        <sps_quotation>
            <general>
                <!-- 0 = off, 1 = on, 2 = only for developer IPs (Advanced > Developer > Developer Client Restrictions) -->
                <enabled>0</enabled>
                <valid_days>14</valid_days>
                <number_prefix>Q</number_prefix>
                <freight_label>Freight (as quoted)</freight_label>
            </general>
            <request>
                <enabled>1</enabled>
                <intro>Tell us where the item is going and we'll e-mail you a shipping quote.</intro>
                <success_message>Thank you! We received your request and will e-mail your shipping quote shortly.</success_message>
                <limit_per_hour>5</limit_per_hour>
            </request>
            <email>
                <identity>sales</identity>
                <staff_recipient/>
                <copy_to/>
                <request_staff_template>sps_quotation_email_request_staff_template</request_staff_template>
                <request_customer_template>sps_quotation_email_request_customer_template</request_customer_template>
                <quotation_template>sps_quotation_email_quotation_template</quotation_template>
            </email>
        </sps_quotation>
    </default>
</config>
