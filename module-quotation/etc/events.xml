<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- before payment: refuse orders whose cart no longer equals the quotation -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="sps_quotation_guard_order" instance="SPS\Quotation\Observer\GuardQuotationOrder"/>
    </event>
    <event name="sales_model_service_quote_submit_success">
        <observer name="sps_quotation_mark_ordered" instance="SPS\Quotation\Observer\MarkQuotationOrdered"/>
    </event>
</config>
