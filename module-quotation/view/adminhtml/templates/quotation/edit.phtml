<?php
$config = $vm->getJsConfig();
$texts = json_encode([
    'remove' => (string) __('Remove'),
    'none' => (string) __('No products found.'),
    'choose' => (string) __('-- Please Select --'),
    'required' => (string) __('required'),
    'priceHint' => (string) __('Empty = catalog price'),
    'confirmSend' => (string) __('Save and e-mail this quotation to the customer?'),
    'confirmCancel' => (string) __('Cancel this quotation? The customer\'s checkout link will stop working.'),
    'confirmDelete' => (string) __('Delete this quotation permanently?'),
    'empty' => (string) __('No items yet — search for a product below.'),
], JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
$script = <<<JS
(() => {
    const cfg = {$config};
    const t = {$texts};
    const form = document.getElementById('sps-quotation-form');
    const body = document.querySelector('#sps-q-items tbody');
    const storeSelect = document.getElementById('q-store');
    let index = 0;

    const el = (tag, attrs = {}, text = null) => {
        const node = document.createElement(tag);
        Object.entries(attrs).forEach(([k, v]) => { if (v !== null && v !== false) node.setAttribute(k, v === true ? '' : v); });
        if (text !== null) node.textContent = text;
        return node;
    };
    const money = (n) => (isFinite(n) ? n : 0).toFixed(2);

    const updateRow = (tr) => {
        const qty = parseFloat(tr.querySelector('input.qty').value) || 0;
        const input = tr.querySelector('input.price');
        // empty = catalog price (shown as the placeholder)
        const price = parseFloat(input.value.trim() !== '' ? input.value : input.placeholder);
        tr.querySelector('.row-total').textContent = isNaN(price) ? '' : money(qty * price);
    };
    const updateEmpty = () => {
        const empty = body.querySelector('tr.empty');
        const rows = body.querySelectorAll('tr.item').length;
        if (!rows && !empty) {
            const tr = el('tr', { class: 'empty' });
            tr.appendChild(el('td', { colspan: '6' }, t.empty));
            body.appendChild(tr);
        } else if (rows && empty) {
            empty.remove();
        }
    };

    const optionControl = (def, name, current) => {
        const wrap = el('div', { class: 'item-option' });
        const id = 'opt-' + index + '-' + def.id;
        wrap.appendChild(el('label', { for: id }, def.title + (def.required ? ' (' + t.required + ')' : '')));
        if (def.type === 'field' || def.type === 'area') {
            const input = el(def.type === 'area' ? 'textarea' : 'input', { id, name, class: 'admin__control-text' });
            input.value = current ?? '';
            wrap.appendChild(input);
            return wrap;
        }
        const multiple = def.type === 'checkbox' || def.type === 'multiple';
        const select = el('select', { id, name: name + (multiple ? '[]' : ''), class: 'admin__control-select', multiple });
        if (!multiple) { select.appendChild(el('option', { value: '' }, t.choose)); }
        const chosen = [].concat(current ?? []).map(String);
        def.values.forEach((v) => {
            const o = el('option', { value: String(v.id) }, v.title);
            o.selected = chosen.includes(String(v.id));
            select.appendChild(o);
        });
        wrap.appendChild(select);
        return wrap;
    };

    const addRow = (item) => {
        const i = index++;
        const prefix = 'items[' + i + ']';
        const tr = el('tr', { class: 'item' });
        const product = el('td');
        product.appendChild(el('input', { type: 'hidden', name: prefix + '[product_id]', value: String(item.product_id) }));
        product.appendChild(el('input', { type: 'hidden', name: prefix + '[original_price]', value: item.original_price ?? '' }));
        product.appendChild(el('div', {}, item.name));
        product.appendChild(el('div', { class: 'sku' }, item.sku));
        product.appendChild(el('input', { type: 'hidden', name: prefix + '[extra]', value: JSON.stringify(item.extra || {}) }));
        (item.details || []).forEach((d) => {
            product.appendChild(el('div', { class: 'item-detail' }, d.label + ': ' + d.value));
        });
        (item.definitions || []).forEach((def) => {
            product.appendChild(optionControl(def, prefix + '[options][' + def.id + ']', (item.options || {})[def.id]));
        });
        const qty = el('td');
        qty.appendChild(el('input', { class: 'admin__control-text qty', name: prefix + '[qty]', value: String(item.qty ?? 1), inputmode: 'decimal', required: true }));
        const catalog = el('td', {}, item.original_price !== null && item.original_price !== undefined ? money(parseFloat(item.original_price)) : '');
        const price = el('td');
        // empty unless staff quote a different price; the catalog price (the price the customer saw) is the
        // placeholder and is what an empty box saves
        const catalogPrice = item.original_price === null || item.original_price === undefined ? null : parseFloat(item.original_price);
        const special = item.price !== null && item.price !== undefined
            && (catalogPrice === null || Math.abs(parseFloat(item.price) - catalogPrice) >= 0.005);
        price.appendChild(el('input', {
            class: 'admin__control-text price', name: prefix + '[price]', inputmode: 'decimal',
            value: special ? money(parseFloat(item.price)) : '',
            placeholder: catalogPrice === null ? '' : money(catalogPrice),
            title: t.priceHint
        }));
        const total = el('td', { class: 'row-total' });
        const actions = el('td');
        if (!cfg.locked) {
            const remove = el('button', { type: 'button', class: 'action-default' }, t.remove);
            remove.addEventListener('click', () => { tr.remove(); updateEmpty(); });
            actions.appendChild(remove);
        }
        [product, qty, catalog, price, total, actions].forEach((td) => tr.appendChild(td));
        tr.addEventListener('input', () => updateRow(tr));
        body.appendChild(tr);
        updateRow(tr);
        updateEmpty();
    };

    cfg.items.forEach(addRow);
    updateEmpty();

    // product search
    const search = document.getElementById('sps-q-search-input');
    const results = document.getElementById('sps-q-results');
    let timer = null;
    let found = [];
    const closeResults = () => { results.hidden = true; results.innerHTML = ''; };
    if (search) {
        search.addEventListener('input', () => {
            clearTimeout(timer);
            const q = search.value.trim();
            if (q.length < 2) { closeResults(); return; }
            timer = setTimeout(async () => {
                const url = new URL(cfg.searchUrl, window.location.href);
                url.searchParams.set('q', q);
                url.searchParams.set('store_id', storeSelect.value);
                url.searchParams.set('isAjax', 'true');
                url.searchParams.set('form_key', window.FORM_KEY || '');
                const response = await fetch(url, { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const data = response.ok ? await response.json() : { items: [] };
                found = data.items || [];
                results.innerHTML = '';
                if (!found.length) {
                    results.appendChild(el('li', { role: 'option', 'aria-disabled': 'true' }, t.none));
                }
                found.forEach((p, n) => {
                    const li = el('li', { role: 'option', 'data-index': String(n) }, p.name + ' — ' + p.sku + ' (' + money(p.original_price) + ')');
                    li.addEventListener('click', () => {
                        addRow({ ...p, qty: 1, price: null, options: {} });
                        search.value = '';
                        closeResults();
                    });
                    results.appendChild(li);
                });
                results.hidden = false;
            }, 250);
        });
        search.addEventListener('keydown', (event) => { if (event.key === 'Escape') { closeResults(); } });
        document.addEventListener('click', (event) => { if (!event.target.closest('.sps-q-search')) { closeResults(); } });
    }

    // regions
    const country = document.getElementById('q-country');
    const regionSelect = document.getElementById('q-region-id');
    const regionText = document.getElementById('q-region');
    const refreshRegions = () => {
        const list = cfg.regions[country.value] || [];
        regionSelect.innerHTML = '';
        if (!list.length) {
            regionSelect.hidden = true;
            regionText.hidden = false;
            return;
        }
        regionSelect.appendChild(el('option', { value: '' }, t.choose));
        list.forEach((r) => {
            const o = el('option', { value: String(r.id) }, r.name);
            o.selected = String(r.id) === regionSelect.dataset.value;
            regionSelect.appendChild(o);
        });
        regionSelect.hidden = false;
        regionText.hidden = true;
    };
    country.addEventListener('change', () => { regionSelect.dataset.value = ''; refreshRegions(); });
    regionSelect.addEventListener('change', () => {
        regionSelect.dataset.value = regionSelect.value;
        regionText.value = regionSelect.value ? regionSelect.options[regionSelect.selectedIndex].text : '';
    });
    refreshRegions();

    // buttons
    const sendButton = document.getElementById('sps-q-save-send');
    if (sendButton) {
        sendButton.addEventListener('click', (event) => {
            if (!window.confirm(t.confirmSend)) { event.preventDefault(); return; }
            document.getElementById('sps-q-send').value = '1';
        });
    }
    const saveButton = document.getElementById('sps-q-save');
    if (saveButton) {
        saveButton.addEventListener('click', () => { document.getElementById('sps-q-send').value = '0'; });
    }
    const cancelButton = document.getElementById('sps-q-cancel');
    if (cancelButton) {
        cancelButton.addEventListener('click', (event) => { if (!window.confirm(t.confirmCancel)) { event.preventDefault(); } });
    }
    const deleteButton = document.getElementById('sps-q-delete');
    if (deleteButton) {
        deleteButton.addEventListener('click', (event) => { if (!window.confirm(t.confirmDelete)) { event.preventDefault(); } });
    }
})();
JS;
